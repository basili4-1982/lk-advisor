# HTTP
ADDR=:8080

# PostgreSQL
DATABASE_URL=postgres://lk:lk@localhost:55432/lk?sslmode=disable

# LLM (DeepSeek). Key is taken from DEEPSEEK_API_KEY when LLM_API_KEY is empty.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Relation review policy: >= auto-confirm is accepted without a human,
# >= review is a candidate, below is quarantine.
RELATION_AUTO_CONFIRM=true
RELATION_AUTO_CONFIRM_THRESHOLD=0.85
RELATION_REVIEW_THRESHOLD=0.70
